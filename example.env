TIDAL_CLIENT_ID=client_id_here
TIDAL_CLIENT_SECRET=client_secret_here
HIFI_SOURCES=https://hund.qqdl.site,https://katze.qqdl.site,https://maus.qqdl.site,https://vogel.qqdl.site,https://wolf.qqdl.site

# Qobuz source. Downloads use arcod.xyz's stream API, so that is the instance to point at —
# older Qobuz-DL instances (qobuz.squid.wtf and friends) are no longer supported.
# QOBUZ_DL_SOURCES=https://arcod.xyz
#
# An ARCOD account is REQUIRED for downloads: searching and browsing work as a guest, but the
# stream endpoint is account-gated. Register at https://arcod.xyz, then fill these in.
# Quote the password, and backslash-escape any $ in it (see the ANTRA_PASSWORD note below).
# QOBUZ_DL_EMAIL=you@example.com
# QOBUZ_DL_PASSWORD='password_here'
#
# Download quality: 27=Hi-Res 24-bit (default), 7=Studio 24-bit, 6=FLAC 16-bit, 5=MP3 320kbps
# QOBUZ_DL_QUALITY=27
#
# Only needed for an instance with a captcha; arcod.xyz does not use one. Open the site in your
# browser, pass the captcha, then copy the cookies from DevTools → Application → Cookies.
# QOBUZ_DL_COOKIES=qobuz-session=xxx; cf_clearance=yyy
#
# arcod signs in through Supabase. Both default to arcod.xyz's own values (its anon key is the
# publishable one from its frontend), so set these only to target a different instance or if
# arcod rotates the key.
# QOBUZ_DL_SUPABASE_URL=https://fnlghyzwyoklfqyhqlav.supabase.co
# QOBUZ_DL_SUPABASE_KEY=eyJ...

# Base URL of a lucida-api instance (https://github.com/davidofsky/lucida-api), used as a fallback source
# LUCIDA_API_URL=http://127.0.0.1:3000

#--- DEV settings ---#
# MUSIC_DIRECTORY=music
# DATA_DIRECTORY=data
#--- DEV settings ---#

#--- Optional settings ---#
# CLEAN_EXISTING_DOWNLOADS=true
# CLEAN_EXISTING_DOWNLOADS_TTL_SECONDS=3600
# TRACK_DISC_SEPARATOR=.
# TRACK_TITLE_SEPARATOR=" - "
# TRACK_PAD_LENGTH=2
# Attempts per source before giving up on a download (default 3)
# DOWNLOAD_MAX_RETRIES=3
# LOG_LEVEL=info
#--- Optional settings ---#
