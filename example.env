TIDAL_CLIENT_ID=client_id_here
TIDAL_CLIENT_SECRET=client_secret_here
HIFI_SOURCES=https://hund.qqdl.site,https://katze.qqdl.site,https://maus.qqdl.site,https://vogel.qqdl.site,https://wolf.qqdl.site

# Comma-separated URLs of self-hosted Qobuz-DL server instances (https://github.com/QobuzDL/Qobuz-DL)
# QOBUZ_DL_SOURCES=https://qobuz.squid.wtf
# All cookies from qobuz.squid.wtf — open the site in your browser, pass the captcha, then copy all cookies from DevTools → Application → Cookies as "name=value; name2=value2"
# QOBUZ_DL_COOKIES=qobuz-session=xxx; cf_clearance=yyy
# Download quality: 27=Hi-Res 24-bit (default), 7=Studio 24-bit, 6=FLAC 16-bit, 5=MP3 320kbps
# QOBUZ_DL_QUALITY=27

#--- DEV settings ---#
MUSIC_DIRECTORY=music
DATA_DIRECTORY=data
#--- DEV settings ---#

#--- Optional settings ---#
# CLEAN_EXISTING_DOWNLOADS=true
# CLEAN_EXISTING_DOWNLOADS_TTL_SECONDS=3600
# TRACK_DISC_SEPARATOR=.
# TRACK_TITLE_SEPARATOR=" - "
# TRACK_PAD_LENGTH=2
# LOG_LEVEL=info
#--- Optional settings ---#
